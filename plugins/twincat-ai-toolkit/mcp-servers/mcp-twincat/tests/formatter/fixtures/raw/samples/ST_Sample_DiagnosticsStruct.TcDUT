<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="ST_Sample_DiagnosticsStruct" Id="{8aae9002-1af9-40ad-89d2-6e4c0d17dea7}">
    <Declaration><![CDATA[TYPE ST_Sample_DiagnosticsStruct :
STRUCT
    (* --- Light device aggregation (previous cycle snapshot) --- *)
    nLightCount                 : UINT; (* Number of reporting light devices *)
    fArtificialLevelSum         : REAL; (* [0..100] - Sum of artificial light levels *)
    fArtificialLevelMean        : REAL; (* [0..100] - Mean artificial light level; 0 if nLightCount = 0 *)
    nLightManualCount           : UINT; (* Number of reporting lights in ManualOperation *)
    nLightExternalOverrideCount : UINT; (* Lights with active prio neither None nor DaylightAutomation *)
    bLightExternalOverride      : BOOL; (* TRUE when nLightExternalOverrideCount > 0 *)
    nLightForeignLightCount     : UINT; (* Of those, the ones actually emitting light (level > 0) *)
    bLightForeignLightActive    : BOOL; (* TRUE when nLightForeignLightCount > 0 *)
    nLightCalibrationCount      : UINT; (* Lights owned by DeskCal this cycle *)


    (* Color temperature aggregation (ColorTemp-capable lights only) *)
    nLightColorTempCount      : UINT; (* Lights reporting a valid color temperature *)
    fLightColorTempKelvinSum  : REAL; (* [K] - Sum of reported color temperatures *)
    fLightColorTempKelvinMean : REAL; (* [K] - Mean color temperature; 0 if nLightColorTempCount = 0 *)


    (* --- Blind device aggregation (previous cycle snapshot) --- *)
    nBlindCount            : UINT; (* Number of reporting blind devices *)
    fBlindPositionSum      : REAL; (* [0..100] - Sum of blind positions *)
    fBlindPositionMean     : REAL; (* [0..100] - Mean blind position; 0 if nBlindCount = 0 *)
    nBlindManualCount      : UINT; (* Number of reporting blinds in ManualOperation *)
    nBlindCalibrationCount : UINT; (* Blinds owned by DeskCal (excl. windows) *)


    (* Angle aggregation (Shade/Sunblind only) *)
    nBlindAngleCount : UINT; (* Blinds reporting a valid angle *)
    fBlindAngleSum   : REAL; (* [deg] - Sum of reported angles *)
    fBlindAngleMean  : REAL; (* [deg] - Mean angle; 0 if nBlindAngleCount = 0 *)


    (* Per NESW facade: 0=North, 1=East, 2=South, 3=West *)
    arrFacadeBlindCount            : ARRAY[0..3] OF UINT; (* Reporting blinds that set this facade bit *)
    arrFacadeBlindPositionMean     : ARRAY[0..3] OF REAL; (* [0..100] - Mean position for that facade bit *)
    arrFacadeBlindCalibrationCount : ARRAY[0..3] OF UINT; (* NESW blinds owned by DeskCal *)
    arrFacadeBlindAngleCount       : ARRAY[0..3] OF UINT; (* Blinds reporting angle for this facade bit *)
    arrFacadeBlindAngleMean        : ARRAY[0..3] OF REAL; (* [deg] - Mean angle for that facade bit *)


    (* --- Occupancy / room sensors (resolved values; *Valid = real source) --- *)
    bMotionSensor              : BOOL; (* Raw motion (sensor or fallback) *)
    bMotionSensorValid         : BOOL; (* TRUE when motion came from stMeasurements *)
    fBrightnessSensorLux       : REAL; (* [Lux] - Effective ceiling / room brightness *)
    bBrightnessSensorValid     : BOOL; (* TRUE when brightness came from stMeasurements *)
    fDeskBrightnessSensorLux   : REAL; (* [Lux] - Effective desk / workplace sensor *)
    bDeskBrightnessSensorValid : BOOL; (* TRUE when desk brightness came from stMeasurements *)
    fHumiditySensor            : REAL; (* [%RH] - Effective room humidity *)
    bHumiditySensorValid       : BOOL; (* TRUE when humidity came from stMeasurements *)
    fCO2Sensor                 : REAL; (* [ppm] - Effective room CO2 / CO2-equivalent *)
    bCO2SensorValid            : BOOL; (* TRUE when CO2 came from stMeasurements *)
    fTemperatureSensor         : REAL; (* [°C] - Effective room temperature *)
    bTemperatureSensorValid    : BOOL; (* TRUE when temperature came from sensor *)
    bOccupancyActive           : BOOL; (* Occupancy: motion hold + Presence delay chains *)
    bOccupancyValid            : BOOL; (* TRUE when occupancy is based on a valid motion sensor *)
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>