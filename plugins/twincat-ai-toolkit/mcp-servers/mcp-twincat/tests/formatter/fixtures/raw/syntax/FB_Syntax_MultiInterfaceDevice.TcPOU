END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_sDevName := sInitialName;
FB_init   := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_exit" Id="{887c71e8-7828-4442-9b2f-2f63854eb053}">
