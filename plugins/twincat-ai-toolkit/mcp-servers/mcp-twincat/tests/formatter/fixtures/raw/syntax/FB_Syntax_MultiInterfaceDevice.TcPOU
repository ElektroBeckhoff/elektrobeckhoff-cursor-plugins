  <POU Name="FB_Syntax_MultiInterfaceDevice" Id="{8cb04f98-bce6-427f-94ad-73a7aa9cfb42}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Syntax_MultiInterfaceDevice IMPLEMENTS I_Syntax_AdvancedDevice, I_Syntax_Widget
