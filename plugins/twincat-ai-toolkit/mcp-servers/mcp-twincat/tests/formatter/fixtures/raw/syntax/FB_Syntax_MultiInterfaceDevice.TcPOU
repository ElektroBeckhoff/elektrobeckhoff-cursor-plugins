    _nErrCode   : DINT;
    _sDevName   : STRING(80);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[;
]]></ST>
    </Implementation>
    <Method Name="FB_init" Id="{01bbffdc-7377-4c7b-bbf7-9f4c39dc0d1c}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
    bInitRetains : BOOL;
