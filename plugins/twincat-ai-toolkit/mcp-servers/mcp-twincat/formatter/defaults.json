{
  "$meta": {
    "_about": "Documentation only — dot-path keys describe settings; not read by the formatter pipeline.",
    "alignment.address_assignments": "Align name / AT / address columns for AT %I/%Q/%M direct-variable declarations. Wired in align_declarations.",
    "alignmentHeuristics.three_line_assign_group_max_lhs_len": "Exact max(lhs) for the 3-line qualified member-access +2 pad rule in _assign_operator_target_col.",
    "calls.max_enum_single_line": "Split inline enum members when count exceeds limit (split_inline_enum_members in align_declarations).",
    "alignMultiline.array_initializers": "Align field := and comments inside name := [( ... ), ( ... )] array-of-struct inits (align_array_struct_inits)."
  },
  "indent": {
    "size": 4,
    "style": "spaces",
    "indent_cases_in_case": true,
    "indent_statements_in_case": true,
    "indent_else_case": false,
    "indent_derived_types": true,
    "indent_do_in_for": false,
    "indent_then_in_if": false,
    "indent_last_comment_before_case": false,
    "indent_last_comment_before_else": false,
    "continuous_indent_multiplier": 1,
    "reindent": true,
    "fix_over_indented_end_if": true
  },
  "lineLength": {
    "wrap_at": 230,
    "wrap_enabled": true,
    "wrap_after_operator": true
  },
  "blankLines": {
    "after_multiline_case": 0,
    "after_multiline_comment": 0,
    "after_multiline_declaration": 0,
    "after_multiline_statement": 0,
    "after_singleline_case": 0,
    "after_singleline_comment": 0,
    "after_singleline_declaration": 0,
    "after_singleline_statement": 0,
    "after_statement_with_body": 1,
    "after_var_blocks": 0,
    "at_implementation_end": 1,
    "at_implementation_start": 0,
    "before_multiline_comment": 0,
    "before_multiline_declaration": 0,
    "before_multiline_statement": 0,
    "before_singleline_comment": 0,
    "before_singleline_declaration": 0,
    "before_singleline_statement": 0,
    "before_statement_with_body": 1,
    "max_consecutive": 1
  },
  "spaces": {
    "after_comma": true,
    "after_declaration_colon": true,
    "before_declaration_colon": true,
    "around_additive_operator": true,
    "around_assignment_operator": true,
    "around_assignment_in_call": true,
    "around_assignment_in_init": true,
    "around_comment": true,
    "around_comparison_operator": true,
    "around_dot": false,
    "around_equality_operator": true,
    "around_term_operator": true,
    "before_array_brackets": false,
    "before_array_init_brackets": false,
    "before_comma": false,
    "before_fb_init_parens": false,
    "before_invocation_parens": false,
    "before_semicolon": false,
    "before_struct_init_parens": false,
    "before_subrange_parens": false,
    "between_nested_parens": false,
    "inside_array_brackets": false,
    "inside_array_init_brackets": false,
    "inside_expression_parens": false,
    "inside_fb_init_parens": false,
    "inside_invocation_parens": false,
    "inside_struct_init_parens": false,
    "inside_subrange_parens": false,
    "around_pragma": true,
    "normalize_inline": false
  },
  "alignment": {
    "declarations": true,
    "assignments": true,
    "fb_call_params": true,
    "comments": true,
    "address_assignments": true,
    "enum_initializers": true,
    "align_init_operator": true,
    "max_init_type_spread": 999,
    "max_assign_spread": 999,
    "join_continuations": true,
    "split_overlength_decls": true
  },
  "alignmentHeuristics": {
    "join_wrapped_assignments": true,
    "bool_literal_min_group_lines": 3,
    "bool_literal_name_spread_max": 2,
    "assign_already_aligned_max_gap": 1,
    "compact_orphan_assign_min_gap": 3,
    "compact_orphan_assign_max_gap": 0,
    "compact_orphan_simple_identifier_only": true,
    "compact_orphan_expression_rhs_max_gap": 0,
    "compact_orphan_expression_rhs_min_gap_floor": 10,
    "compact_orphan_skip_rhs_or_and_chain": true,
    "compact_pair_assigns": true,
    "compact_pair_min_over_pad": 8,
    "compact_group_min_lines": 4,
    "compact_group_max_over_pad": 3,
    "compact_three_line_count": 3,
    "compact_three_line_over_pad": 2,
    "compact_bool_chain_assigns": true,
    "compact_same_col_outlier_enabled": false,
    "compact_same_col_outlier_min_gap": 8,
    "compact_same_col_outlier_lhs_delta": 2,
    "decl_comment_preserve_tight_gap": true,
    "decl_comment_preserve_source_gap": 1,
    "decl_comment_preserve_max_col_delta": 1,
    "decl_split_outlier_median_multiplier": 1.5,
    "decl_split_outlier_median_add": 20,
    "split_case_inline_statements": true,
    "split_case_numeric_labels_only": true,
    "split_case_keep_else_inline_comment": true,
    "blank_after_assign_before_comment": true,
    "blank_after_assign_before_for": true,
    "blank_after_assign_before_related_if": true,
    "blank_after_assign_before_related_if_skip_if_rhs_contains_paren": false,
    "blank_after_end_if_before_if": true,
    "align_for_body_assignments": true,
    "align_for_body_min_group_lines": 3,
    "align_for_body_long_rhs_len_threshold": 30,
    "align_for_body_min_lhs_spread_for_alignment": 3,
    "expand_tight_assignment_spacing": true,
    "three_line_assign_group_count": 3,
    "three_line_assign_group_min_spread": 12,
    "three_line_assign_group_max_lhs_len": 36,
    "three_line_assign_group_min_qualified_count": 2,
    "three_line_assign_group_extra_pad": 2,
    "align_chained_init_assignments": true,
    "align_ref_to_preceding_assign": true,
    "align_init_injection_if_bodies": true,
    "align_pre_chained_true_orphans": true,
    "normalize_case_arm_single_assignments": true
  },
  "alignMultiline": {
    "array_initializers": true,
    "chained_binary": true,
    "fb_init_assignments": true,
    "fb_init_params": true,
    "invocation_params": true,
    "invocation_assignments": true,
    "struct_init_assignments": true,
    "struct_init_params": true
  },
  "lineBreaks": {
    "keep_existing": false,
    "after_if": false,
    "before_then": true,
    "before_do_in_for": false,
    "before_statements_in_case": true,
    "after_pragma": "keep_existing",
    "after_type_keyword": false,
    "place_struct_on_new_line": true,
    "place_simple_if_single_line": false,
    "wrap_before_comma": false,
    "after_left_paren_invocation": true,
    "after_left_paren_struct_init": true,
    "after_left_paren_fb_init": false,
    "after_left_paren_enum": false,
    "after_left_bracket_array": false,
    "before_left_paren_invocation": false,
    "before_left_paren_struct_init": false,
    "before_left_paren_fb_init": false,
    "before_left_paren_enum": false,
    "before_left_bracket_array": false,
    "before_right_paren_invocation": false,
    "before_right_paren_struct_init": false,
    "before_right_paren_fb_init": false,
    "before_right_paren_enum": false,
    "before_right_bracket_array": false
  },
  "calls": {
    "max_params_single_line": 4,
    "max_struct_init_single_line": 3,
    "max_fb_init_single_line": 3,
    "max_array_init_single_line": 30,
    "max_enum_single_line": 5,
    "multiline_indent": 8,
    "normalize_param_indent": true,
    "join_single_line_when_fits": true
  },
  "parentheses": {
    "array_init_style": 2,
    "fb_init_style": 2,
    "function_call_style": 2,
    "enum_style": 2,
    "struct_init_style": 2
  },
  "keywords": {
    "uppercase": true
  },
  "xml": {
    "indent_size": 2,
    "sort_methods": true,
    "sort_actions": true,
    "sort_properties": true
  },
  "validation": {
    "check_name_match": true,
    "check_guids": true,
    "check_structure": true
  },
  "safety": {
    "backup": true,
    "delete_backup_on_success": true,
    "syntax_check": true
  },
  "lineEnding": "auto"
}
