{
  "name": "twincat-iecst",
  "displayName": "TwinCAT 3 Structured Text & Tooling",
  "description": "TwinCAT 3 Structured Text language support, syntax highlighting, and LSP integration powered by twincat_core.",
  "version": "0.1.0",
  "publisher": "ElektroBeckhoff",
  "author": "elektrobeckhoff",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElektroBeckhoff/elektrobeckhoff-cursor-plugins"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "twincat",
    "beckhoff",
    "plc",
    "structured text",
    "iec61131-3",
    "iecst"
  ],
  "activationEvents": [
    "onLanguage:iecst",
    "workspaceContains:**/*.plcproj",
    "workspaceContains:**/*.TcPOU",
    "workspaceContains:**/*.TcDUT",
    "workspaceContains:**/*.TcGVL"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "iecst",
        "aliases": [
          "Structured Text",
          "IEC 61131-3 ST",
          "TwinCAT ST",
          "iecst"
        ],
        "extensions": [
          ".TcPOU",
          ".TcGVL",
          ".TcDUT",
          ".TcIO",
          ".TcTTO",
          ".st",
          ".iecst"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "iecst",
        "scopeName": "source.iecst",
        "path": "./syntaxes/iecst.tmLanguage.json"
      },
      {
        "scopeName": "xml.iecst.codeblock",
        "path": "./syntaxes/xml.iecst.codeblock.json",
        "injectTo": [
          "text.xml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.iecst": "iecst"
        }
      }
    ],
    "themes": [
      {
        "label": "TwinCAT 3 XAE (Light)",
        "uiTheme": "vs",
        "path": "./themes/twincat-xae-light.json"
      },
      {
        "label": "TwinCAT 3 XAE (Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/twincat-xae-dark.json"
      }
    ],
    "commands": [
      {
        "command": "twincat.formatSection",
        "title": "TwinCAT: Format Current Section / Member",
        "category": "TwinCAT"
      },
      {
        "command": "twincat.restartServer",
        "title": "TwinCAT: Restart Language Server",
        "category": "TwinCAT"
      },
      {
        "command": "twincat.ai.checkSyntax",
        "title": "TwinCAT AI: Check Syntax & Diagnostics",
        "category": "TwinCAT AI"
      },
      {
        "command": "twincat.ai.pagefaultAudit",
        "title": "TwinCAT AI: Pagefault & Safety Audit",
        "category": "TwinCAT AI"
      },
      {
        "command": "twincat.ai.addComments",
        "title": "TwinCAT AI: Add Comments (* *)",
        "category": "TwinCAT AI"
      }
    ],
    "submenus": [
      {
        "id": "twincat.submenu",
        "label": "TwinCAT"
      },
      {
        "id": "twincat.ai.submenu",
        "label": "TwinCAT AI"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "twincat.submenu",
          "when": "resourceExtname =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst)$/i || resourceFilename =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst)$/i || resourceExt =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst)$/i || editorLangId == iecst",
          "group": "1_twincat@1"
        },
        {
          "submenu": "twincat.ai.submenu",
          "when": "resourceExtname =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst)$/i || resourceFilename =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst)$/i || resourceExt =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst)$/i || editorLangId == iecst",
          "group": "1_twincat@2"
        }
      ],
      "explorer/context": [
        {
          "submenu": "twincat.submenu",
          "when": "explorerResourceIsFolder || resourceExtname =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst|plcproj)$/i || resourceFilename =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst|plcproj)$/i || resourceExt =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst|plcproj)$/i",
          "group": "7_twincat@1"
        },
        {
          "submenu": "twincat.ai.submenu",
          "when": "explorerResourceIsFolder || resourceExtname =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst|plcproj)$/i || resourceFilename =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst|plcproj)$/i || resourceExt =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst|plcproj)$/i",
          "group": "7_twincat@2"
        }
      ],
      "twincat.submenu": [
        {
          "command": "twincat.formatSection",
          "when": "editorTextFocus",
          "group": "1_format@1"
        },
        {
          "command": "twincat.restartServer",
          "group": "2_server@1"
        }
      ],
      "twincat.ai.submenu": [
        {
          "command": "twincat.ai.checkSyntax",
          "group": "1_actions@1"
        },
        {
          "command": "twincat.ai.pagefaultAudit",
          "group": "1_actions@2"
        },
        {
          "command": "twincat.ai.addComments",
          "group": "1_actions@3"
        }
      ],
      "commandPalette": [
        {
          "command": "twincat.restartServer"
        },
        {
          "command": "twincat.formatSection",
          "when": "editorIsOpen"
        },
        {
          "command": "twincat.ai.checkSyntax",
          "when": "editorIsOpen"
        },
        {
          "command": "twincat.ai.pagefaultAudit",
          "when": "editorIsOpen"
        },
        {
          "command": "twincat.ai.addComments",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "twincat.formatSection",
        "key": "ctrl+k ctrl+s",
        "mac": "cmd+k cmd+s",
        "when": "editorTextFocus && (resourceExtname =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst)$/i || resourceFilename =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst)$/i || resourceExt =~ /\\.(TcPOU|TcDUT|TcGVL|TcIO|TcTTO|st|iecst)$/i || editorLangId == iecst)"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "TwinCAT Language Server",
      "properties": {
        "twincat.server.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python executable running twincat_core.lsp"
        },
        "twincat.server.extraPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional PYTHONPATH directories for twincat_core module lookup"
        },
        "twincat.server.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the TwinCAT Language Server"
        },
        "twincat.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable document formatting via twincat_core"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "package": "vsce package --no-dependencies -o twincat-iecst.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  }
}
